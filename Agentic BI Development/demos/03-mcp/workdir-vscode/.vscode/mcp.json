{
    "inputs": [
        {
            "type": "promptString",
            "id": "fabric-token",
            "description": "Fabric access token (from: az account get-access-token --resource https://api.fabric.microsoft.com)",
            "password": true
        }
    ],
    "servers": {
        "powerbi-authoring-remote": {
            "type": "http",
            "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi/authoring",
            "headers": {
                "Authorization": "Bearer ${input:fabric-token}"
            }
        }
    }
}
